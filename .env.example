# ============================================================================
# UXUI AI Helper — environment variables
# ============================================================================
# Variables prefixed with VITE_ are inlined into the client bundle by Vite
# at build time. Only PUBLIC values belong in this group. NEVER put secrets
# here (API keys, tokens, etc.) — the browser would ship them.
#
# Variables WITHOUT a VITE_ prefix are read SERVER-SIDE only by the
# Vercel Serverless Functions under /api/*.
# ============================================================================


# ----------------------------------------------------------------------------
# Client-side (Vite inlined)
# ----------------------------------------------------------------------------

# Optional override for the backend URL the frontend dials.
#
#   - Unset (default): production builds dial the hardcoded
#     https://uxui-ai-helper.vercel.app URL. Local dev with `vite dev` /
#     `vercel dev` resolves against the current origin (relative path).
#   - Set: forces the frontend to dial this absolute URL instead. Useful
#     when testing the bundle against a custom staging backend or a
#     local tunnel:
#       VITE_API_BASE_URL=http://localhost:3000          # vercel dev
#       VITE_API_BASE_URL=https://staging.example.com    # custom
#       VITE_API_BASE_URL=https://uxui-ai-helper.vercel.app
#
# Always include the scheme and host. No trailing slash.
# VITE_API_BASE_URL=https://uxui-ai-helper.vercel.app


# ----------------------------------------------------------------------------
# Server-side (Vercel Serverless Functions — NEVER exposed to the browser)
# ----------------------------------------------------------------------------

# OpenRouter API key. The /api/improve-prompt endpoint reads this
# server-side and uses it to call https://openrouter.ai/api/v1/chat/completions.
# Set this in the Vercel project env (Production + Preview) — do NOT
# commit it.
# OPENROUTER_API_KEY=sk-or-...

# OpenRouter model identifier. Defaults to "qwen/qwen3-30b-a3b" (no
# `:free` suffix — that routes to a different model pool that is
# unreliable). Override here without redeploying code.
# OPENROUTER_MODEL=qwen/qwen3-30b-a3b
