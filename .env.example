# ----------------------------------------------------------------------------
# SERVER-SIDE environment variables (read by /api/improve-prompt.ts and
# /api/health.ts only — NEVER bundled into the browser).
# Set these in your Vercel project settings, NOT in `.env.local`.
# ----------------------------------------------------------------------------

# REQUIRED. The Ollama HTTPS base URL the SERVERLESS FUNCTION can reach
# at runtime. Examples for a production VPS deployment:
#   https://ollama.your-vps.example       (Ollama behind a reverse proxy
#                                          that terminates TLS — Caddy /
#                                          Nginx on the VPS)
#   https://your-tunnel.trycloudflare.com (Cloudflare Tunnel pointing at
#                                          the daemon on your VPS)
#
# Treat this as the ROOT of the daemon, not the API endpoint — the
# function appends `/api/generate` and `/api/tags` itself. Do NOT include
# `/api` here, or you'll get a doubled path (404 upstream):
#   WRONG: https://ollama.example/api   → fetches /api/api/generate (404)
#   RIGHT: https://ollama.example       → fetches /api/generate
#
# The browser never sees this value. The function refuses plaintext http://
# in production / preview (VERCEL_ENV in {production, preview}) so HTTPS
# is required for production deploys. Loopback hostnames (localhost /
# 127.0.0.1 / 0.0.0.0 / ::1) are also refused in production — they are
# not reachable from a Vercel function runtime, so we'd just burn a 60s
# function timeout before reporting a config error.
OLLAMA_BASE_URL=

# OPTIONAL. Defaults to 'llama3'. Examples: qwen3, deepseek-r1,
# qwen2.5-coder, mistral, llama3.2.
OLLAMA_MODEL=llama3

# OPTIONAL. Per-request timeout against Ollama, in ms. Defaults to 120000.
# Floor: 1000ms so a typo like "5" doesn't silently set a 5ms abort.
# Must stay below the function's maxDuration (60s for /api/improve-prompt).
OLLAMA_TIMEOUT_MS=120000

# OPTIONAL. Escape hatch for the HTTPS scheme enforcement above. Set to
# "true" ONLY if you genuinely cannot terminate TLS in front of your VPS
# Ollama daemon and accept plaintext transport (not recommended — the
# user's prompts are sent across the wire unencrypted). Server-side log
# records the opt-in with a warning so it shows up in observability.
# Has no effect outside production / preview deploys.
OLLAMA_INSECURE=false

# ----------------------------------------------------------------------------
# CLIENT-SIDE (read by Vite at build time, may be bundled into the page)
# ----------------------------------------------------------------------------

# OPTIONAL. Override the API base URL the BROWSER calls. Defaults to the
# same origin as the page (production behavior). Set this only for
# `vite dev` setups where you want the page to dial a deployed preview
# backend instead of `vercel dev`. Examples:
#   https://your-app.vercel.app
# Leave empty for normal `vercel dev` / production deployments.
# The frontend NEVER reads OLLAMA_BASE_URL — that variable is server-only.
VITE_API_BASE_URL=

# NOTE: if your VPS reverse proxy validates a shared secret on incoming
# requests (recommended — Vercel's edge IP ranges change, so pinning to
# them is brittle), pass the secret as a header from the function by
# configuring your reverse proxy to accept any incoming token. This
# template does not define OLLAMA_AUTH_HEADER by design — see README
# "Production VPS deployment" for the Caddyfile / Nginx snippets.
