# =============================================================================
# Ollama (local LLM) configuration — copy to .env.local and edit as needed.
# =============================================================================

# Base URL of the running Ollama daemon. Only used by the Vite dev server's
# HTTP proxy to forward /api/ollama/* requests to the daemon.
# Defaults to http://127.0.0.1:11434 if unset.
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Which model the prompt-engineering agent should run on. Change to any model
# you have locally: e.g. llama3, llama3.2, qwen3, qwen2.5-coder, deepseek-r1,
# mistral, phi3, codellama, …
# Pull it first with: ollama pull <model-name>
VITE_OLLAMA_MODEL=llama3
