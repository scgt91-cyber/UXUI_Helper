# ----------------------------------------------------------------------------
# Ollama endpoint (REQUIRED — no localhost fallback by design)
# ----------------------------------------------------------------------------
# This frontend is deployed on Vercel / production host and NEVER attempts to
# connect to a local Ollama daemon directly. You must set
# VITE_OLLAMA_BASE_URL to an HTTPS URL the deployed BROWSER can reach.
#
# Acceptable values:
#   - A public tunnel to your local Ollama (HTTPS required):
#       https://your-tunnel.example.com
#   - A hosted Ollama endpoint over HTTPS:
#       https://ollama.your-host.example
#
# NOT acceptable (browser cannot reach these from a deployed context):
#   - any loopback URL          (Vercel / preview origin can't dial a local port)
#   - any other http://... URL  (Mixed Content on an https:// page)
#
# Format: full URL, no trailing slash. Path /api/generate is appended
# automatically by the client.
VITE_OLLAMA_BASE_URL=

# ----------------------------------------------------------------------------
# Model name (optional — defaults to 'llama3')
# ----------------------------------------------------------------------------
VITE_OLLAMA_MODEL=llama3

# ----------------------------------------------------------------------------
# Per-request timeout in ms (optional — minimum floor 1000, defaults to 120000)
# ----------------------------------------------------------------------------
VITE_OLLAMA_TIMEOUT_MS=120000
