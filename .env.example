# =============================================================================
# Ollama (local LLM) configuration — copy to .env.local and edit as needed.
# =============================================================================

# Base URL the BROWSER can reach to call Ollama directly (the AI service
# calls `${VITE_OLLAMA_BASE_URL}/api/generate` from the browser; there is
# no server-side proxy in this app).
#   - Local dev (npm run dev):  http://127.0.0.1:11434 works — Ollama's
#     default OLLAMA_ORIGINS allows localhost origins.
#   - AI-agent preview / hosted deployment: point this at a tunnel
#     (Cloudflare Tunnel, ngrok) or a hosted Ollama instance. The URL
#     must be reachable from the page's network.
#
# CORS / Mixed Content:
# - If the page is on a different origin, Ollama's OLLAMA_ORIGINS env var
#   must allow that origin (or be `*`).
# - HTTPS pages cannot reach HTTP Ollama endpoints (Mixed Content). Use
#   HTTPS for VITE_OLLAMA_BASE_URL when the page is HTTPS.
#
# Note: OLLAMA_ORIGINS is configured on the Ollama daemon itself
# (`OLLAMA_ORIGINS="https://your-preview-host" ollama serve`), NOT here.
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model name. Pull it first with `ollama pull <name>`.
# Good defaults for prompt-engineering: llama3, llama3.2, qwen3,
# qwen2.5-coder, mistral, deepseek-r1 (the last emits <think> tags; the
# app strips them).
VITE_OLLAMA_MODEL=llama3

# Per-request timeout in ms. 1000ms floor, 120000ms (2 min) default.
# Raise this for first-call cold-start loads of large models.
VITE_OLLAMA_TIMEOUT_MS=120000
